[Unit]
Description=An API for collecting usage data.
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
User=obsAPI
WorkingDirectory=/var/lib/observationAPI
ExecStart=/usr/local/bin/observationAPI
WatchdogSec=30
Restart=on-watchdog
RestartSec=5s

[Install]
WantedBy=multi-user.target
